{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,scripts/**,.venv/**,.git/**,data/**,.streamlit/secrets.toml,*.sqlite*,.env*}"
    }
  },
  "rewrites": [
    {"source": "/(.*)", "destination": "/api/index"}
  ]
}
